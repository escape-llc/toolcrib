{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "ai-ui",
  "version": "1.0.0",
  "description": "AI-consumable component manifest for React UI toolkit. All units are rem unless noted.",
  "themeSystem": {
    "colorSpace": "HSV",
    "supportedHarmonies": ["monochromatic", "analogous", "split-complementary", "triadic", "tetradic"],
    "cssVariables": [
      "--ai-color-base",
      "--ai-color-primary",
      "--ai-color-primary-hover",
      "--ai-color-secondary",
      "--ai-color-accent",
      "--ai-bg-primary",
      "--ai-bg-surface",
      "--ai-bg-container",
      "--ai-text-primary",
      "--ai-text-secondary",
      "--ai-border",
      "--ai-focus-ring",
      "--ai-subtheme-error",
      "--ai-subtheme-success",
      "--ai-subtheme-warning",
      "--ai-subtheme-info",
      "--ai-accordion-header-padding",
      "--ai-accordion-item-gap",
      "--ai-accordion-animation",
      "--ai-tab-header-padding",
      "--ai-tab-indicator-style",
      "--ai-table-cell-padding",
      "--ai-table-row-height",
      "--ai-slideout-width",
      "--ai-slideout-backdrop-blur",
      "--ai-slideout-header-margin",
      "--ai-card-header-padding",
      "--ai-card-padding",
      "--ai-margin-gap",
      "--ai-transition-normal",
      "--ai-transition-duration-normal",
      "--ai-transition-easing"
    ]
  },
  "zIndexScale": {
    "BASE": 0,
    "STICKY": 10,
    "SPLITTER": 20,
    "DRAWER": 100,
    "MODAL": 200,
    "DROPDOWN": 300,
    "TOOLTIP": 400,
    "TOAST": 500
  },
  "eventBus": {
    "singleton": "aiBus",
    "hookName": "useAIEvent",
    "channels": [
      {
        "name": "theme:changed",
        "payload": "{ parameters: ThemeParameters; palette: GeneratedPalette; cssVariables: Record<string, string> }"
      },
      { "name": "popup:shown", "payload": "{ id: string; targetId?: string; data?: any }" },
      { "name": "popup:hidden", "payload": "{ id: string }" },
      { "name": "slideout:shown", "payload": "{ id: string; position?: 'top'|'right'|'bottom'|'left'; data?: any }" },
      { "name": "slideout:hidden", "payload": "{ id: string }" },
      { "name": "modal:shown", "payload": "{ id: string; data?: any }" },
      { "name": "modal:hidden", "payload": "{ id: string }" },
      { "name": "form:submitted", "payload": "{ formId?: string; values: Record<string, any> }" },
      { "name": "form:validated", "payload": "{ formId?: string; isValid: boolean }" },
      { "name": "form:errored", "payload": "{ formId?: string; errors: Record<string, string> }" },
      { "name": "toast:shown", "payload": "{ id: string; type: ToastType; message: string; priority?: ToastPriority }" },
      { "name": "toast:dismissed", "payload": "{ id: string; reason?: 'user'|'expired'|'action' }" },
      { "name": "toast:expired", "payload": "{ id: string; message?: string; type?: string }" },
      { "name": "toast:action_clicked", "payload": "{ id: string; actionLabel: string }" },
      { "name": "accordion:opened", "payload": "{ id?: string; itemValue: string }" },
      { "name": "accordion:closed", "payload": "{ id?: string; itemValue: string }" },
      { "name": "tab:changed", "payload": "{ activeId: string; previousId?: string }" },
      { "name": "select:changed", "payload": "{ name?: string; value: string }" },
      { "name": "slider:changed", "payload": "{ name?: string; value: number }" },
      { "name": "menu:opened", "payload": "{ id?: string }" },
      { "name": "menu:closed", "payload": "{ id?: string }" },
      { "name": "menu:item_selected", "payload": "{ id?: string; itemValue: string }" },
      { "name": "tooltip:shown", "payload": "{ id?: string; content: string }" },
      { "name": "tooltip:hidden", "payload": "{ id?: string }" },
      { "name": "layout:domain:created", "payload": "{ domainId: string; parentId: string; orientation: 'horizontal'|'vertical' }" },
      { "name": "layout:corners:squared", "payload": "{ domainId: string; slot: 'first'|'second'; orientation: 'horizontal'|'vertical'; squaredCorners: {...} }" }
    ],
    "helperMethods": [
      { "method": "aiBus.openModal(id, data?)", "emits": "modal:shown" },
      { "method": "aiBus.closeModal(id)", "emits": "modal:hidden" },
      { "method": "aiBus.openSlideOut(id, position?, data?)", "emits": "slideout:shown" },
      { "method": "aiBus.closeSlideOut(id)", "emits": "slideout:hidden" },
      { "method": "aiBus.showToast(message, type?, priority?)", "emits": "toast:shown", "returns": "string (toast id)" }
    ]
  },
  "components": [
    {
      "name": "Card",
      "import": "import { Card } from 'ai-ui'",
      "slots": ["Header", "Content", "Footer", "Actions"],
      "props": {
        "layout": { "type": "'default' | 'auto'", "default": "'default'", "description": "'auto' enables flex fill + corner squaring" },
        "squareCorners": { "type": "SquareCornerOption", "default": "undefined", "description": "'auto' defers to layout domain" },
        "style": { "type": "React.CSSProperties" },
        "className": { "type": "string" }
      },
      "description": "Slot-based container with automatic layout domain corner squaring"
    },
    {
      "name": "CardSimple",
      "import": "import { CardSimple } from 'ai-ui'",
      "props": {
        "title": { "type": "ReactNode", "description": "Header title text" },
        "subtitle": { "type": "ReactNode", "description": "Secondary text in header" },
        "footer": { "type": "ReactNode", "description": "Footer content" },
        "actions": { "type": "ReactNode", "description": "Action buttons in footer" },
        "layout": { "type": "'default' | 'auto'", "default": "'default'" },
        "squareCorners": { "type": "SquareCornerOption" }
      },
      "description": "Token-saving shorthand for simple cards without slot composition"
    },
    {
      "name": "Form",
      "import": "import { Form, FormField, FormError, Input, Select, Checkbox, Switch, Textarea, RadioGroup, Slider, SubmitButton, Button } from 'ai-ui'",
      "props": {
        "schema": { "type": "ZodType", "description": "Zod 4 validation schema" },
        "initialValues": { "type": "Partial<T>", "default": "{}" },
        "onSubmit": { "type": "(values: T) => void | Promise<void>" },
        "id": { "type": "string", "description": "Also used as formId in bus payloads" }
      },
      "childComponents": ["FormField", "FormError", "Button", "SubmitButton", "Input", "Select", "Checkbox", "Switch", "Textarea", "RadioGroup", "Slider"],
      "description": "Zod 4 schema-driven form. Controls bind via context — no register() or onChange boilerplate"
    },
    {
      "name": "Splitter",
      "import": "import { Splitter } from 'ai-ui'",
      "slots": ["Panel"],
      "props": {
        "orientation": { "type": "'vertical' | 'horizontal'", "default": "'vertical'", "description": "vertical = top/bottom panels" },
        "initialSplit": { "type": "number", "default": "70", "description": "Percentage for first panel (0-100)" },
        "minSize": { "type": "number", "default": "15", "description": "Minimum panel percentage" }
      },
      "constraints": "Requires exactly 2 children",
      "description": "Resizable two-panel layout with automatic corner-squaring domain"
    },
    {
      "name": "Accordion",
      "import": "import { Accordion } from 'ai-ui'",
      "props": {
        "items": { "type": "AccordionItemData[]", "description": "{ value, title, content, disabled? }[]" },
        "type": { "type": "'single' | 'multiple'", "default": "'single'" },
        "defaultValue": { "type": "string" },
        "id": { "type": "string" }
      },
      "description": "Data-driven collapsible panel group with animations"
    },
    {
      "name": "TabStrip",
      "import": "import { TabStrip } from 'ai-ui'",
      "slots": ["Tab", "Panel"],
      "props": {
        "items": { "type": "TabItem[]", "description": "{ id, label, icon?, disabled? }[]" },
        "activeId": { "type": "string", "description": "Currently active tab id (controlled)" },
        "onChange": { "type": "(id: string) => void" }
      },
      "description": "Scrollable tab header with filmstrip overflow. Use TabStrip.Panel for content"
    },
    {
      "name": "Toolbar",
      "import": "import { Toolbar } from 'ai-ui'",
      "slots": ["Left", "Center", "Right"],
      "props": {
        "paddingMode": { "type": "PaddingMode" },
        "cornerRadiusMode": { "type": "CornerRadiusMode" }
      },
      "description": "Horizontal action bar with left/center/right slot areas"
    },
    {
      "name": "VStack",
      "import": "import { VStack } from 'ai-ui'",
      "props": {
        "gap": { "type": "'xs'|'sm'|'md'|'lg'|'xl'|'gap'", "default": "'gap'" },
        "align": { "type": "'start'|'center'|'end'|'stretch'", "default": "'stretch'" },
        "justify": { "type": "'start'|'center'|'end'|'between'|'around'", "default": "'start'" }
      },
      "description": "Vertical flex column layout primitive"
    },
    {
      "name": "HStack",
      "import": "import { HStack } from 'ai-ui'",
      "props": {
        "gap": { "type": "'xs'|'sm'|'md'|'lg'|'xl'|'gap'", "default": "'gap'" },
        "align": { "type": "'start'|'center'|'end'|'stretch'", "default": "'center'" },
        "justify": { "type": "'start'|'center'|'end'|'between'|'around'", "default": "'start'" }
      },
      "description": "Horizontal flex row layout primitive"
    },
    {
      "name": "Grid",
      "import": "import { Grid } from 'ai-ui'",
      "props": {
        "columns": { "type": "number | 'auto-fit' | 'auto-fill'", "default": "2" },
        "minColWidth": { "type": "string", "default": "'16rem'" },
        "gap": { "type": "'xs'|'sm'|'md'|'lg'|'xl'|'gap'", "default": "'gap'" }
      },
      "description": "CSS Grid responsive multi-column layout"
    },
    {
      "name": "UIGroup",
      "import": "import { UIGroup } from 'ai-ui'",
      "props": {
        "orientation": { "type": "'horizontal' | 'vertical'", "default": "'horizontal'" },
        "borderRadius": { "type": "string" }
      },
      "description": "Merges adjacent elements into a single visual compound control"
    },
    {
      "name": "Popup",
      "import": "import { Popup } from 'ai-ui'",
      "props": {
        "trigger": { "type": "ReactElement", "required": true },
        "placement": { "type": "PopupPlacement", "default": "'bottom-start'" },
        "id": { "type": "string" },
        "isOpen": { "type": "boolean" },
        "onOpenChange": { "type": "(open: boolean) => void" },
        "zIndex": { "type": "number", "default": "Z_INDEX.DROPDOWN (300)" }
      },
      "description": "Anchored popover with light dismiss and corner-squaring to trigger"
    },
    {
      "name": "SlideOut",
      "import": "import { SlideOut } from 'ai-ui'",
      "props": {
        "trigger": { "type": "ReactElement" },
        "position": { "type": "'top'|'right'|'bottom'|'left'", "default": "'right'" },
        "title": { "type": "ReactNode", "default": "'Slide Out Panel'" },
        "width": { "type": "string", "default": "'var(--ai-slideout-width, 23.75rem)'" },
        "id": { "type": "string" },
        "isOpen": { "type": "boolean" },
        "onOpenChange": { "type": "(open: boolean) => void" },
        "zIndex": { "type": "number", "default": "Z_INDEX.DRAWER (100)" }
      },
      "description": "Edge drawer overlay with backdrop blur and slide animation"
    },
    {
      "name": "Modal",
      "import": "import { Modal } from 'ai-ui'",
      "slots": ["Header", "Body", "Footer", "Actions", "CloseButton"],
      "props": {
        "trigger": { "type": "ReactElement" },
        "width": { "type": "string", "default": "'31.25rem'" },
        "id": { "type": "string" },
        "isOpen": { "type": "boolean" },
        "onOpenChange": { "type": "(open: boolean) => void" },
        "zIndex": { "type": "number", "default": "Z_INDEX.MODAL (200)" }
      },
      "description": "Dialog overlay with focus trap, backdrop, and slot composition"
    },
    {
      "name": "Tooltip",
      "import": "import { Tooltip } from 'ai-ui'",
      "props": {
        "content": { "type": "ReactNode", "required": true },
        "side": { "type": "'top'|'right'|'bottom'|'left'", "default": "'top'" },
        "align": { "type": "'start'|'center'|'end'", "default": "'center'" },
        "delayDuration": { "type": "number", "default": "200" }
      },
      "description": "Hover/focus tooltip wrapping a child trigger element"
    },
    {
      "name": "DropdownMenu",
      "import": "import { DropdownMenu } from 'ai-ui'",
      "props": {
        "trigger": { "type": "ReactElement", "required": true },
        "items": { "type": "MenuItemData[]", "required": true, "description": "{ value, label, icon?, disabled?, isSeparator?, onClick? }[]" },
        "side": { "type": "'top'|'right'|'bottom'|'left'", "default": "'bottom'" },
        "align": { "type": "'start'|'center'|'end'", "default": "'start'" }
      },
      "description": "Data-driven action menu with separator support"
    },
    {
      "name": "DataTable",
      "import": "import { DataTable } from 'ai-ui'",
      "props": {
        "data": { "type": "T[]", "required": true },
        "columns": { "type": "Column<T>[]", "required": true, "description": "{ key, title, render?, sortable?, width? }[]" },
        "pageSize": { "type": "number", "default": "10" },
        "pageSizeOptions": { "type": "number[]", "default": "[5, 10, 25, 50, 100]" },
        "itemHeight": { "type": "number", "default": "44", "description": "Row height in px for virtualization" },
        "containerHeight": { "type": "number | 'auto'", "default": "'auto'" }
      },
      "description": "Virtualized, sortable, paginated data table with sticky headers"
    },
    {
      "name": "ThemeEditor",
      "import": "import { ThemeEditor } from 'ai-ui'",
      "props": {
        "isOpen": { "type": "boolean" },
        "onOpenChange": { "type": "(open: boolean) => void" },
        "trigger": { "type": "ReactElement" }
      },
      "description": "Real-time HSV theme editor rendered in a SlideOut panel"
    }
  ]
}
