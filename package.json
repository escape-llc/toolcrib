{
  "name": "toolcrib",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "imports": {
    "#toolcrib": "./src/index.ts"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "check-manifest": "node scripts/generate-manifest.js",
    "generate-manifest": "node scripts/generate-manifest.js --write",
    "check-docs": "node scripts/generate-docs.js",
    "generate-docs": "node scripts/generate-docs.js --write",
    "check-index": "node scripts/generate-index.js",
    "generate-index": "node scripts/generate-index.js --write",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "generate-storyboard": "node scripts/generate-storyboard.js"
